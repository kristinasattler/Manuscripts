R03_summary <- R02_summary %>%
  separate_wider_delim(                                                     # Split "Group1 - Group2" text into separate columns
    Contrast,                                                               # Select the Contrast column
    delim = "-",                                                            # Split groups by the hyphen
    names = c("group1", "group2"),                                          # Name the columns "group1" and "group2"
    cols_remove = FALSE,                                                    # Keep the original Contrast column too
    too_many = "merge"                                                      # If a group name itself contains "-", merge the extra pieces
  ) %>%
  mutate(
    group1 = trimws(gsub("[()]", "", group1)),                                    # Clean up group1 text (remove parentheses/whitespace)
    group2 = trimws(gsub("[()]", "", group2)),                                    # Clean up group2 text (remove parentheses/whitespace)
    !!sym(DV01_Condition_Column_1) := factor(.data[[DV01_Condition_Column_1]],    # Lock in display order for DV01_Condition_Column_1 groups
                                             levels = L01_Group_1_Order),
    Contrast = factor(Contrast, levels = unique(c(L02_Target_Order, Contrast)))   # Lock in display order for Contrast with L02_Target_Order
  ) %>%
  group_by(.data[[DV01_Condition_Column_1]]) %>%                             # Group rows by DV01_Condition_Column_1 to calculate offsets within each group
  mutate(
    n_comparisons = n_distinct(Contrast),                                    # Count how many comparisons exist per group
    comp_rank = dense_rank(as.numeric(Contrast)),                            # Rank each comparison within its group
    Sub_Offset = if_else(n_comparisons == 1, 0,                              # Calculate vertical spacing so multiple comparisons don't overlap
                         ((n_comparisons + 1) / 2 - comp_rank) * G_y_Offset) # Multiply value by G_y_Offset
  ) %>%
  ungroup() %>%
  mutate(
    Group_Base = as.numeric(factor(.data[[DV01_Condition_Column_1]],        # Calculate base vertical position for each group
                                   levels = rev(L01_Group_1_Order))) * 1.5, # Reverse the group order so they appear top-bottom
    Y_Pos = Group_Base + Sub_Offset,                                        # Combine base position and offset for final vertical position
    Mean_Difference = Mean_Difference * -1,                                 # Flip sign so plot direction matches expected convention
    LowerCI = LowerCI * -1,                                                 # Flip sign to match Mean_Difference
    UpperCI = UpperCI * -1                                                  # Flip sign to match Mean_Difference
  )

