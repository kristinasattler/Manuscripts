### [**Chunk 2 - Fit the Linear Mixed Effects Model**]
###### [**DO NOT EDIT**]
########################################################################################################################################

```{r Chunk 2 - Fit the Linear Mixed Model}
F02_lmm_formula <- as.formula(                              # Build the model formula as text, then convert it to a formula object
  paste0(
    "`", DV01_Data_Column, "` ~ `",                         # Start formula: predict Data_Column values
    DV01_Condition_Column_1, "` * `",                       # ...by the interaction of DV01_Condition_Column_1
    DV01_Condition_Column_2, "` + (1 | `",                  # ...and DV01_Condition_Column_2, plus a random effect
    DV01_Condition_Column_0, "`)"                           # ...grouped by DV01_Condition_Column_0 (e.g., Sample_ID)
  )
)
B01_lmm_fit <- lmer(F02_lmm_formula, data = A01_sub_data)   # Fit the linear mixed effects model using the formula and data
B02_anova <- anova(B01_lmm_fit, type = 3)                   # Run a Type III ANOVA on the fitted model to test overall significance
```

########################################################################################################################################
### [**Chunk 3 - Apply post-hoc comparisons**]
###### [**DO NOT EDIT**]
########################################################################################################################################

```{r Chunk 3 - Apply post-hoc comparisons}
F03_emm_specs <- as.formula(                              # Create the emmeans specification formula 
  paste0("~ `", DV01_Condition_Column_2, "` | `",         # Compare DV01_Condition_Column_2 groups separately within each DV01_Condition_Column_1 group
         DV01_Condition_Column_1, "`")
)
C01_emm_results <- emmeans(B01_lmm_fit, F03_emm_specs)    # Calculate estimated marginal means for each group combination
C02_pairwise_contrast <- pairs(C01_emm_results,           # Run pairwise comparisons between groups
                               adjust = "tukey")          # Adjust p-values for multiple comparisons
C03_eff_sizes <- eff_size(                                # Calculate effect sizes (Cohen's d) for each pairwise comparison
  C01_emm_results, 
  sigma = sigma(B01_lmm_fit),                             # Use the model's residual standard deviation
  edf = df.residual(B01_lmm_fit)                          # Use the model's residual degrees of freedom
)
```

