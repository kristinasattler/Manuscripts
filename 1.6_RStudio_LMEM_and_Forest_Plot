```{r Chunk 6 - Create the forest plot}
G00_forest_plot <- ggplot(R06_points_long,                # Start a plot using the reshaped comparison data
                          aes(x = Mean_Difference,             # Plot the mean difference on the x-axis
                              y = Y_Pos                         # Plot the pre-calculated vertical position on the y-axis
                          )) +
  geom_vline(xintercept = 0,                                # Draw a vertical reference line at zero (no difference)
             linetype = "dashed", 
             color = "grey60", 
             linewidth = 0.6) +
  geom_errorbarh(                                           # Draw horizontal error bars for each comparison
    aes(xmin = LowerCI,                                     # Left edge of the error bar (lower confidence limit)
        xmax = UpperCI),                                    # Right edge of the error bar (upper confidence limit)
    color = R06_points_long$M_group_1_dark_color,           # Color each error bar by its Condition_Column_1 group
    height = 0.2,                                           # Set the height of the error bar caps
    linewidth = 1,                                          # Set the thickness of the error bar line
    show.legend = FALSE                                     # Don't show this layer in the legend
  ) +
  geom_point(                                                # Add a point for each group in the comparison
    data = R06_points_long,
    aes(
      x = Point_X_Pos,                                       # Use the dodge-adjusted x position so points don't overlap
      y = Y_Pos,                                             # Match the same vertical position as the error bar
      shape = M_dot_shape,                                   # Set point shape by Condition_Column_2 group
      fill = M_light_color,                                  # Set point fill color by Condition_Column_2 group
      color = M_dark_color                                   # Set point outline color by Condition_Column_2 group
    ),
    size = 3.5,                                               # Set the size of the points
    stroke = 0.8,                                             # Set the thickness of the point outline
    show.legend = FALSE                                       # Don't show this layer in the legend
  ) +
  scale_y_continuous(                                        # Customize the y-axis
    breaks = R07_y_axis_labels$Center_Pos,                   # Place axis labels at each group's calculated center position
    labels = R07_y_axis_labels[[DV01_Condition_Column_1]]    # Label each break with its Condition_Column_1 group name
  ) +
  scale_shape_identity() +                                    # Use the R shapes specified rather than arbitrarily assigned shapes
  scale_fill_identity() +                                     # Use the bar colors specified rather than arbitrarily assigned colors
  scale_color_identity() +                                    # Use the bar outline colors specified rather than arbitrarily assigned colors
  theme_classic() +                                           # Set the appearance of the chart- see above for theme options
  labs(title = G_Graph_Title,                             # Set the title of the graph from the dynamic variable
       x = G_X_Axis_Title,                                # Set the title of the x-axis from the dynamic variable 
       y = G_Y_Axis_Title,                                # Set the title of the y-axis from the dynamic variable
  ) +
  theme(                                                      # Set appearance of specific components of the chart
    legend.position = "none",                                 # Remove the legend from the plot
    axis.ticks.y = element_line(linewidth = 1),             # EDIT (OPTIONAL): Set the width of y-axis ticks
    axis.line = element_line(linewidth = 1),                # EDIT (OPTIONAL): Set the width of axis lines
    plot.title = if(is.null(L01_variables$G_Graph_Title))     # Check if G_Graph_Title = NULL
