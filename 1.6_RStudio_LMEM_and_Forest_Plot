F04_group_rename <- function(x) {        # Create a helper function to remove special characters from group names
  x <- gsub("[()]", "", x)               # Remove parentheses
  x <- trimws(x)                         # Remove leading/trailing whitespace
  x <- gsub("[^[:alnum:]]+", "_", x)     # Replace remaining special characters with underscores
  x <- gsub("^_+|_+$", "", x)            # Remove leading/trailing underscores
  return(x)
}

# Look up each comparison's group labels from M01_Condition_2_Variables, then build both possible Forward and Reverse contrast name orders
E01_Keep_Contrasts <- L00_comparisons %>%
  mutate(
    Label_1 = M01_Condition_2_Variables[[DV01_Condition_Column_2]][match(trimws(Comp_1), trimws(M01_Condition_2_Variables[[M01_Sort_Column_1]]))],
    Label_2 = M01_Condition_2_Variables[[DV01_Condition_Column_2]][match(trimws(Comp_2), trimws(M01_Condition_2_Variables[[M01_Sort_Column_1]]))],
    Forward = paste(Label_1, "-", Label_2),
    Reverse = paste(Label_2, "-", Label_1)
  )

E02_Normalized_Targets <- F04_group_rename(na.omit(c(E01_Keep_Contrasts$Forward,      # Clean the target contrast names for matching
                                                     E01_Keep_Contrasts$Reverse)))
E03_Match_Found <- length(E02_Normalized_Targets) > 0 &&                              # Check that target contrasts exist
  any(F04_group_rename(R01_summary$Contrast) %in% E02_Normalized_Targets)             # Check that at least one matches the model results

if (E03_Match_Found) {                                               # Check if E03_Match_Found = TRUE
  L02_Target_Order <- na.omit(E01_Keep_Contrasts$Forward)            # Use the specified comparison order
  R02_summary <- R01_summary %>%
    filter(F04_group_rename(Contrast) %in% E02_Normalized_Targets)   # Keep only those matching contrasts
} else {                                                             # If E03_Match_Found = FALSE
  L02_Target_Order <- unique(R01_summary$Contrast)                   # Use the order contrasts already appear in and keep all contrasts
  R02_summary <- R01_summary
}

R02_summary <- R02_summary %>%
  mutate(Contrast = factor(Contrast, levels = unique(Contrast)))     # Lock in the final display order for Contrast
