```{r Chunk 4 - Create interpretable data frames and merge}
D01_contrast_df <- summary(C02_pairwise_contrast,              # Convert pairwise contrast results into a data frame
                            infer = c(TRUE, TRUE)) %>%         # Specify confidence intervals and p-values
  as.data.frame()                                              # Convert to a data frame

D02_eff_size_df <- summary(C03_eff_sizes,                      # Convert effect size results into a data frame
                            infer = c(TRUE, TRUE)) %>%         # Specify confidence intervals and p-values
  as.data.frame() %>%                                          # Convert to a data frame
  select(                                                      # Keep only the relevant columns
    contrast,                                                  # Which comparison this row represents
    all_of(DV01_Condition_Column_1),                           # Which Condition_Column_1 group the comparison belongs to
    Cohen_d = effect.size,                                     # Rename effect.size to Cohen_d
    d_SE = SE,                                                 # Rename SE to d_SE
    Cohen_d_Lower = lower.CL,                                  # Rename lower.CL to Cohen_d_Lower
    Cohen_d_Upper = upper.CL                                   # Rename upper.CL to Cohen_d_Upper
  )

R01_summary <- D01_contrast_df %>%                             # Start from the pairwise contrast results
  left_join(D02_eff_size_df,                                   # Add matching effect size results
            by = c("contrast", DV01_Condition_Column_1)) %>%   # Match by comparison and DV01_Condition_Column_1
  select(                                                      # Keep and rename only the relevant columns
    !!sym(DV01_Condition_Column_1),                            # Which Condition_Column_1 group the comparison belongs to
    Contrast = contrast,                                       # Rename contrast to Contrast
    Mean_Difference = estimate,                                # Rename estimate to Mean_Difference
    SE,                                                        # Standard error of the mean difference
    LowerCI = lower.CL,                                        # Rename lower.CL to LowerCI
    UpperCI = upper.CL,                                        # Rename upper.CL to UpperCI
    p_value = p.value,                                         # Rename p.value to p_value
    Cohen_d,                                                   # Effect size for the comparison
    Cd_SE = d_SE,                                              # Rename d_SE to Cd_SE
    CdLowerCI = Cohen_d_Lower,                                 # Rename Cohen_d_Lower to CdLowerCI
    CdUpperCI = Cohen_d_Upper                                  # Rename Cohen_d_Upper to CdUpperCI
  ) %>%
  arrange(desc(abs(Cohen_d)))                                  # Sort rows by largest effect size first

R01_summary <- R01_summary %>%                  # Add elements to the test result data frame
  mutate(                                       # Function to create new columns
    p_label = case_when(                        # Name the column and set the value under these conditions
      `p_value` <= 0.0001 ~ "****",           # EDIT (OPTIONAL): If the "p_value" column is < 0.0001, label with ****
      `p_value` <= 0.001 ~ "***",             # EDIT (OPTIONAL): If the "p_value" column is < 0.001, label with ***
      `p_value` <= 0.01 ~ "**",               # EDIT (OPTIONAL): If the "p_value" column is < 0.01, label with **
      `p_value` <= 0.05 ~ "*",                # EDIT (OPTIONAL): If the "p_value" column is < 0.05, label with *
      TRUE ~ "ns"                             # EDIT (OPTIONAL): If the "p_value" column is > 0.05, label with ns
      ))

