```{r Chunk 2 - Organize data frames and create simple summary statistics}
A01_sub_data <- A00_raw_data                                                  # Make a copy of the data frame containing raw data

M01_Condition_1_Variables <- M00_aesthetic_variables %>%                      # Separate the joined aesthetic variables data frame
  filter(.data[[M01_Sort_Column_0]] == DV01_Condition_Column_1) %>%           # Filter by values in the "Factor" column, cohort variables
  select(-any_of(c(M01_dot_shape)))                                           # Remove M01_dot_shape and M01_Sort_Column_1
L01_Group_1_Order <- M01_Condition_1_Variables[[M01_Sort_Column_2]]           # Create a list specifying the order of cohort variables (e.g. stain)

M01_Condition_2_Variables <- M00_aesthetic_variables %>%                      # Separate the joined aesthetic variables data frame
  filter(.data[[M01_Sort_Column_0]] == DV01_Condition_Column_2)               # Filter by values in the "Factor" column, group variables
L01_Group_2_Order <- M01_Condition_2_Variables[[M01_Sort_Column_2]]           # Create a list specifying the order of group variables (e.g. cell type)

pwalk(                                                                        # Assign dynamic variable names from M01_Condition_2_Variables
  list(                                                                       #   to the global environment to use later
    M01_Condition_2_Variables[[M01_Sort_Column_1]],                           # Extract M01_Sort_Column_1 for M01_Condition_2_Variables
    M01_Condition_2_Variables[[M01_Sort_Column_2]]                            # Extract M01_Sort_Column_2 for M01_Condition_2_Variables
  ), 
  function(dyn_var, val) {                                                    # Map each variable name to its value
    assign(dyn_var, val, envir = .GlobalEnv)                                  # Assign each dynamic variable name its value in global environment
  }
)
pwalk(                                                                        # Assign dynamic variable names from M01_Condition_1_Variables
  list(                                                                       #   to the global environment to use later
    M01_Condition_1_Variables[[M01_Sort_Column_1]],                           # Extract M01_Sort_Column_1 for M01_Condition_1_Variables
    M01_Condition_1_Variables[[M01_Sort_Column_2]]                            # Extract M01_Sort_Column_2 for M01_Condition_1_Variables
  ), 
  function(dyn_var, val) {                                                    # Map each variable name to its value
    assign(dyn_var, val, envir = .GlobalEnv)                                  # Assign each dynamic variable name its value in global environment
  }
)
colnames(M01_Condition_1_Variables)[                                    # Rename a column in M01_Condition_1_Variables
  colnames(M01_Condition_1_Variables) == M01_Sort_Column_2              # Change M01_Sort_Column_2 to DV01_Condition_Column
] <- DV01_Condition_Column_1

colnames(M01_Condition_2_Variables)[                                    # Rename a column in M01_Condition_1_Variables
  colnames(M01_Condition_2_Variables) == M01_Sort_Column_2              # Change M01_Sort_Column_2 to DV01_Condition_Column
] <- DV01_Condition_Column_2

A01_sub_data[[DV01_Condition_Column_1]] <- factor(                    # Assign DV01_Condition_Column_1 as a factor
  A01_sub_data[[DV01_Condition_Column_1]],                            # Call DV01_Condition_Column_1 from A01_sub_data
  levels = L01_Group_1_Order)                                         # Assign levels (order) by L01_Group_1_Order

A01_sub_data[[DV01_Condition_Column_2]] <- factor(                    # Assign DV01_Condition_Column_2 as a factor
  A01_sub_data[[DV01_Condition_Column_2]],                            # Call DV01_Condition_Column_2 from A01_sub_data
  levels = L01_Group_2_Order)                                         # Assign levels (order) by L01_Group_2_Order

A01_sub_data[[DV01_Data_Column]] <- as.numeric(                       # Set the DV01_Data_Column values as numeric
  as.character(A01_sub_data[[DV01_Data_Column]]))

B01_summary <- A01_sub_data %>%                           # Create a new data frame called B02_summary
  group_by(.data[[DV01_Condition_Column_1]], 
           .data[[DV01_Condition_Column_2]]) %>%          # Set the columns to sort the groups by
  summarise(                                              # Summarize these parameters for each group
    Mean = mean(.data[[DV01_Data_Column]]),               # Calculate the mean value of each group
    n = n(),                                              # Calculate the number of samples in each group
    SD = sd(.data[[DV01_Data_Column]]),                   # Calculate the standard deviation of each group
    SE = SD / sqrt(n),                                    # Calculate the standard error of each group
    Min = min(.data[[DV01_Data_Column]]),                 # Calculate the minimum value of each group
    Max = max(.data[[DV01_Data_Column]])                  # Calculate the maximum value of each group
  )

B02_summary <- B01_summary %>%                            # Create a new data frame to include aesthetic variables 
  left_join(M01_Condition_2_Variables,                    # Join aesthetic variables to B01_summary 
            by = DV01_Condition_Column_2) %>%             # Join aesthetic variables to B01_summary 
  select(-any_of(c(M01_Sort_Column_0)))                   # Remove M01_Sort_Column_0

B02_summary[[DV01_Condition_Column_1]] <- factor(                    # Assign DV01_Condition_Column_1 as a factor
  B02_summary[[DV01_Condition_Column_1]],                            # Call DV01_Condition_Column_1 from A01_sub_data
  levels = L01_Group_1_Order)                                        # Assign levels (order) by L01_Group_1_Order

B02_summary[[DV01_Condition_Column_2]] <- factor(                    # Assign DV01_Condition_Column_2 as a factor
  B02_summary[[DV01_Condition_Column_2]],                            # Call DV01_Condition_Column_2 from A01_sub_data
  levels = L01_Group_2_Order)                                        # Assign levels (order) by L01_Group_2_Order
```

