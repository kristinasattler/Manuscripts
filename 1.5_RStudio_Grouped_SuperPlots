        if (is.null(v)) {                                            # Check for NULL values
          return("NULL")                                             # Populate "NULL" (rather than 0 or a blank cell)
        } else if (is.function(v)) {                                 # Check if the variable contains an R function
          return(paste(deparse(v), collapse = " "))                  # Convert the function into a continuous string
        } else if (length(v) == 0) {                                 # Check if the variable is an empty vector or structure
          return("NULL")                                             # Output the literal text string "NULL"
        } else {                                                     # Handle standard atomic values or multi-element vectors
          return(paste(v, collapse = ", "))                          # Combine all vector elements into a single comma-separated string
        }
      })
    )
