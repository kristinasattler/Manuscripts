G_Graph_Title <- L01_variables$G_Graph_Title                         # Turn G_Graph_Title into a usable value
G_X_Axis_Title <- L01_variables$G_X_Axis_Title                       # Turn G_X_Axis_Title into a usable value
G_Y_Axis_Title <- L01_variables$G_Y_Axis_Title                       # Turn G_Y_Axis_Title into a usable value
G_X_Axis_Labels <- L01_variables$G_X_Axis_Labels                     # Turn G_X_Axis_Title into a usable value
G_geom_point_size <- L01_variables$G_geom_point_size                 # Turn G_geom_point_size into a usable value
G_position_dodge <- L01_variables$G_position_dodge                   # Turn G_position_dodge into a usable value

G_y_limits <- local({                                                # Create a variable to set y-limits
  G_Ly_limit <- L01_variables$G_Ly_limit                             # Extract lower bound limit
  G_Uy_limit <- L01_variables$G_Uy_limit                             # Extract upper bound limit
  if (is.null(G_Uy_limit) || is.na(G_Uy_limit)) {                    # Check if upper limit = NULL or NA
    NULL                                                             # Set y-limits to NULL if NA or NULL
  } else {                                                           # Use provided [lower, upper] values if limits are defined
    c(G_Ly_limit, G_Uy_limit)
  }
})

G_y_breaks <- local({                                                # Create a variable to set y-limits
  breaks <- L01_variables$G_y_interval                               # Turn G_y_interval into a usable value
  if (is.null(breaks) ||                                             # Check if G_y_interval is NULL
      (is.atomic(breaks) && length(breaks) == 1 && is.na(breaks))    # Check if G_y_interval is length 1 or NA
  ) { 
    return(ggplot2::waiver())                                        # Set y-breaks to default waiver() if NULL or NA
  } else { return(breaks)                                            # If breaks are defined, use provided values
  }
})

G_y_labels <- local({                                                # Create a variable to set y-limits
  raw <- L01_variables$G_y_labels                                    # Extract label setting from L01_variables
  if (is.null(raw)) {                                                # If NULL, use default waiver()
    return(ggplot2::waiver()) 
  } else if (is.function(raw)) {                                     # If custom labeller function (e.g.function(x) x / 1000)
    return(raw)                                                      # Keep function intact
  } else if (is.atomic(raw) && any(is.na(raw))) {                    # If atomic vector containing NA use default waiver()
    return(ggplot2::waiver())
  } else if (is.list(raw)) {                                         # If passed as a list (e.g. c() with expressions)
    flat <- do.call(c, raw)                                          # Flatten list elements
    if (any(is.na(flat))) return(ggplot2::waiver())                  # Check if flattened list contains NA
    return(flat)                                                     # Return flattened vector/expressions
  } else { return(raw)                                               # If no other criteria are met, use the provided values
  }
})
