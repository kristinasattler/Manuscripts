```{r Chunk 3 - Set dimensions of the graph}
L01_variables <- modifyList(                                          # Add to the L01_variables list
  L01_variables, list(                                                # Use the list() function
    G_position_dodge = 0.9,                                         # EDIT (OPTIONAL): Set the position dodge for bars
    G_Ly_limit = 0,                                                 # EDIT (OPTIONAL): Set the lower y-limit of the graph (NA for R default)
    G_Uy_limit = 150,                                             # EDIT (CRITICAL): Set the upper y-limit of the graph (NA for R default)
    G_y_interval = if (isTRUE(L01_variables$G_Log_Y_Axis)) {          # Use log-based spacing if G_Log_Y_Axis = TRUE
      10^(0:6)                                                        # Generates c(1, 10, 100, 1000, 10000, 100000, 1000000)
      } else { NA                                                   # EDIT (OPTIONAL): Set the y-intervals (aka "breaks") (NA for R default)
        },
    G_y_labels = if (isTRUE(L01_variables$G_Log_Y_Axis)) {            # Use log-based labels if G_Log_Y_Axis = TRUE
      function(x) { 
        labs <- scales::label_log(base = 10)(x)                       # Creates default labels as 10^0, 10^1, 10^2, etc.
        labs[x == 1 | x == 0] <- "0"                                  # Lists "0" for 10^0 (x = 1) or 0
        labs[x == 10] <- "10"                                         # Lists "10" for 10^1 (x = 10)
        return(labs)
        } 
      } else { NA #function(x) x / 1000                                 # EDIT (OPTIONAL): Set the y-axis labels after opening bracket (NA for R default)
        },
    G_h_y_intercept = (if (isTRUE(L01_variables$G_Y_Dashed_Line)) {   # Add a horizontal dashed line if G_Y_Dashed_Line = TRUE
      B02_summary %>%                                                 # Call the B02_summary data frame
        filter(.data[[M01_Sort_Column_1]] == "D_Exp_Group01") %>%   # EDIT (OPTIONAL): Filter M01_Sort_Column_1 for the dynamic variable in the string
        pull(Mean)                                                    # Pull the Mean value from the Condition Column to place the line
    } else { NULL                                                     # Ignore if G_Y_Dashed_Line = FALSE
    }),
    G_geom_point_size = 2,                                          # EDIT (OPTIONAL): Set size of data points on the plot
    G_margins = c(5,1,5,1)                                          # EDIT (OPTIONAL): Set the margins of the plot in mm (top, right, bottom, left)
  )
)

