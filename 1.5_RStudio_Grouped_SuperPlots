```{r - Chunk 4 - Create the Graph}
G00_Grouped_SuperPlot <- ggplot(                                  # Create the grouped bar chart using ggdotplot function
  mapping = aes(                                                   # Map aesthetics to the dynamic variables
    x = .data[[DV01_Condition_Column_1]],                          # Set the x-axis to DV01_Condition_Column_1
    fill = .data[[DV01_Condition_Column_2]],                       # Set the fill parameters to match DV01_Condition_Column_2
    color = .data[[DV01_Condition_Column_2]],                      # Set the colors to match DV01_Condition_Column_2
    shape = .data[[DV01_Condition_Column_2]]                       # Set the shapes to match DV01_Condition_Column_2
  )) +
  geom_col_pattern(                                                # Add bars displaying the average value of each group
    data = B02_summary,                                            # Call data from the B02_summary data frame
    aes(y = Mean,                                                  # Set the Y value of each bar to the mean of each group
        fill = .data[[DV01_Condition_Column_2]],                   # Fill bars from DV01_Condition_Column_2
        color = .data[[DV01_Condition_Column_2]],                  # Fill bar outlines from DV01_Condition_Column_2
        pattern = .data[[DV01_Condition_Column_2]],                # Fill patterns from DV01_Condition_Column_2
        pattern_color = .data[[DV01_Condition_Column_2]]           # Fill pattern colors from DV01_Condition_Column_2
        ),
    position = position_dodge(width = G_position_dodge),           # Call G_position_dodge to offset groups of bars
    linewidth = 1,                                               # EDIT (OPTIONAL): Set the width of the bar outlines
    width = 0.8,                                                 # EDIT (OPTIONAL): Set the width of the bars
    pattern_alpha = 0.6,                                         # EDIT (OPTIONAL): Set opacity of the pattern
    pattern_density = 0.1,                                       # EDIT (OPTIONAL): Set the pattern density
    pattern_spacing = 0.01                                       # EDIT (OPTIONAL): Set the pattern spacing
    ) +
  geom_quasirandom(data = A01_sub_data,                            # Add jittered individual data points using quasi-random positioning
                   aes(x = .data[[DV01_Condition_Column_1]],       # Set the x-axis to the conditions column dynamic variable
                       y = .data[[DV01_Data_Column]],              # Set the y-axis to the numerical data column dynamic variable
                       fill = after_scale(color)                   # Match point fill color to outline color after scale evaluation
                   ),
    dodge.width = G_position_dodge,                                # Set the x-axis position to match the bars and points
    size = L01_variables$G_geom_point_size,                        # Set size of the points from G_geom_point_size
    width = 0.15,                                                # EDIT (OPTIONAL): Set spacing of points from the center
    alpha = 1,                                                   # EDIT (OPTIONAL): Set the spacing of data points
  ) +
  geom_errorbar(                                                   # Add error bars
    data = B02_summary,                                            # Call data from B02_summary 
    aes(x = .data[[DV01_Condition_Column_1]],                      # Set the x-axis to DV01_Condition_Column_1
        y = Mean,                                                  # Set the Y value of each error bar to the mean of each group
        group = .data[[DV01_Condition_Column_2]],                  # Group by DV01_Condition_Column_2
        ymin = Mean - SE,                                          # Set the minimum y value of the error bar
        ymax = Mean + SE                                           # Set the maximum y value of the error bar
        ),
    position = position_dodge(width = G_position_dodge),           # Set the x-axis location to match the bars and points
    color = "black",                                             # EDIT (OPTIONAL): Set the colors for error bars
    width = 0.5,                                                 # EDIT (OPTIONAL): Set the width of the error bar ends
    linewidth = 1,                                               # EDIT (OPTIONAL): Set the thickness of the error bar line
    ) +
  scale_shape_manual(values = B02_summary$M_dot_shape) +           # Use the R shapes specified rather than R defaults
  scale_fill_manual(values = B02_summary$M_light_color) +          # Use the bar colors specified rather than R defaults
  scale_color_manual(values = B02_summary$M_dark_color) +          # Use the bar outline colors specified rather than R defaults
  scale_pattern_manual(values = B02_summary$M_bar_pattern) +       # Use the patterns specified rather than R defaults
  scale_pattern_color_manual(values = B02_summary$M_dark_color) +  # Use the patterns colors specified rather than R defaults
  theme_classic() +                                                # Set the appearance of the chart- see above for theme options
  labs(title = G_Graph_Title,                                      # Set the title of the graph from the dynamic variable
       x = G_X_Axis_Title,                                         # Set the title of the x-axis from the dynamic variable 
       y = G_Y_Axis_Title,                                         # Set the title of the y-axis from the dynamic variable
  ) + 
  (if (L01_variables$G_Log_Y_Axis) {
    list( scale_y_log10(                                      # Use a logarithmic y-axis scale if G_Log_Y_Axis = TRUE
      expand = expansion(mult = c(0, 0.05)),                  # Set the amount of white space around the y-axis
      limits = G_y_limits,                                    # Call the range of the y-axis from the dynamic variable
      breaks = G_y_breaks,                                    # Call the height and tick mark intervals of the y-axis
      labels = G_y_labels                                     # Call the y-axis labels that occur at the breaks
      ),
    annotation_logticks(                                      # For a logarithmic y-axis, control y-axis ticks
      sides = "l",                                            # Add tick marks only to the left axis
      short = unit(-0.1, "cm"),                             # EDIT (OPTIONAL): Set the size of short tick marks
      mid = unit(-0.2, "cm"),                               # EDIT (OPTIONAL): Set the size of medium tick marks
      long = unit(-0.3, "cm"),                              # EDIT (OPTIONAL): Set the size of long tick marks
      outside = TRUE                                          # Apply the tick marks
      )
    )
  } else { scale_y_continuous(                                # Use a linear y-axis scale if G_Log_Y_Axis = FALSE
      expand = c(0, 0),                                       # Set the amount of white space around the y-axis
      limits = G_y_limits,                                    # Call the range of the y-axis from the dynamic variable
      breaks = G_y_breaks,                                    # Call the height and tick mark intervals of the y-axis
      labels = G_y_labels                                     # Call the y-axis labels that occur at the breaks
  )}
  ) +
  theme(                                                      # Set appearance of specific components of the chart
    legend.position = "none",                                 # Remove the legend from the plot
    axis.ticks.y = element_line(linewidth = 1),             # EDIT (OPTIONAL): Set the width of y-axis ticks
    axis.line = element_line(linewidth = 1),                # EDIT (OPTIONAL): Set the width of axis lines
    plot.title = if(is.null(L01_variables$G_Graph_Title))     # Check if G_Graph_Title = NULL
      element_blank() else element_text(                      # Remove title if G_Graph_Title = NULL in Chunk 1
        face = "bold",                                      # EDIT (OPTIONAL): Set text weight
        size = 20,                                          # EDIT (OPTIONAL): Set text size
        color = "black",                                    # EDIT (OPTIONAL): Set text color
        hjust = NULL                                        # EDIT (OPTIONAL): Set horizontal justification (0.5 to center)
        ),
    axis.title.x = if(is.null(L01_variables$G_X_Axis_Title))  # Set visual parameters of the c-axis title
      element_blank() else element_text(                      # Remove title if G_X_Axis_Title = NULL in Chunk 1
        face = "bold",                                      # EDIT (OPTIONAL): Set text weight
        size = 20,                                          # EDIT (OPTIONAL): Set text size
        color = "black",                                    # EDIT (OPTIONAL): Set text color
        ),
    axis.text.x = if(L01_variables$G_X_Axis_Labels) 
      element_text(                                           # Set visual parameters of the axis text
        face = "bold",                                      # EDIT (OPTIONAL): Set text weight
        size = 20,                                          # EDIT (OPTIONAL): Set text size
        color = "black",                                    # EDIT (OPTIONAL): Set text color
